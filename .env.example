# GenAPI — ключ API (общий для чата и эмбеддингов)
GENAPI_API_KEY=

# Pinecone — ключ и имя индекса
PINECONE_API_KEY=
PINECONE_INDEX_NAME=

# --- Необязательные настройки (значения по умолчанию показаны ниже) ---

# Чат: OpenAI-совместимый прокси GenAPI
# GENAPI_URL=https://proxy.gen-api.ru/v1/chat/completions
# MODEL_ID=gpt-4o-mini

# Эмбеддинги: нативный API генераций GenAPI (НЕ OpenAI-совместимый формат)
# GENAPI_EMBEDDINGS_URL=https://api.gen-api.ru/api/v1/networks/embeddings
# EMBEDDING_MODEL=text-embedding-3-small

# Прокси только для Pinecone (если требуется)
# Формат: http://<user>:<password>@<host>:<port>
# PINECONE_PROXY_URL=http://user:password@host:port

# --- Telegram-бот ---
# Токен бота (получить через @BotFather в Telegram)
# TELEGRAM_BOT_TOKEN=

# Сетевой прокси для доступа к api.telegram.org (относится ТОЛЬКО к Telegram).
# У Pinecone своя отдельная настройка PINECONE_PROXY_URL; GenAPI работает напрямую.
# Формат: user:password@host:port (без схемы http:// — добавится автоматически)
# PROXY_URL=user:password@host:port

# Таймауты запросов в секундах
# TIMEOUT_GENAPI=30
# TIMEOUT_PINECONE=30
